# ============================================================
# Cleopatra Beauty — Environment variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ---------- Supabase (project URL + keys from Supabase Dashboard → Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER-ONLY. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin account (created by `npm run setup-admin`) ----------
ADMIN_EMAIL=admin@cleopatra-beauty.de
ADMIN_PASSWORD=

# ---------- Stripe (https://dashboard.stripe.com/apikeys) ----------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook secret from Dashboard → Developers → Webhooks (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# ---------- Translation providers (tried in this order) ----------
# 1. Self-hosted LibreTranslate (run `docker compose up -d` in /translator,
#    or point at any existing instance). Free, unlimited.
LIBRETRANSLATE_URL=http://localhost:5000
# 2. Azure Translator free tier (2M chars/month): https://portal.azure.com → Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# 3. Google Cloud Translation API
GOOGLE_TRANSLATE_API_KEY=